# ── IndexNow（可选） ────────────────────────────────
# 用于主动推送 URL 给 Bing/Yandex/Seznam/Naver 等搜索引擎
# 密钥需与 public/{key}.txt 文件名一致，文件内容为该密钥本身
# 生成命令：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=your_indexnow_key_here

# ── Umami Cloud 免费模式（Tracking + Share URL） ───
# Website ID 与脚本 URL 用于追踪；Share ID 仅构造公开统计链接，不读取 Share API。
# 未填写时不启用 Umami 追踪和分析入口；不蒜子首页/文章计数无需这些变量。
# 不要复制参考作者的配置。
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SHARE_ID=
PUBLIC_UMAMI_SCRIPT_URL=

# ── GitHub 项目同步（可选，仅服务端构建） ───────────
# Public API 无 Token 也会尝试；频繁限流时配置具有公开仓库只读权限的 Token。
# 不使用 PUBLIC_ 前缀，不把真实值提交到仓库或浏览器。
GITHUB_TOKEN=
