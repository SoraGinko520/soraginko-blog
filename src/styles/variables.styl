/* ===== 基础变量定义 ===== */
:root
  --radius-large: 0.75rem
  --radius-medium: 0.5rem
  --radius-small: 0.25rem
  --space-1: 0.25rem
  --space-2: 0.5rem
  --space-3: 0.75rem
  --space-4: 1rem
  --space-5: 1.25rem
  --space-6: 1.5rem
  --space-8: 2rem
  --control-size: 2.75rem
  /* Hero 的日光插画保持原色；导览区改用可切换的语义化主题令牌。 */
  --sky-surface: #F6FAFD
  --sky-surface-end: #EAF3F9
  --sky-ink: #244D68
  --sky-muted: #426680
  --sky-border: #8EACBF
  --sky-title-start: #4D86AC
  --sky-title-mid: #4D84A5
  --sky-title-end: #587B9D
  --sky-title-size: clamp(1.8rem, 3.25vw, 4.2rem)
  --sky-occupation-size: clamp(0.75rem, 1vw, 1.05rem)
  --sky-badge-size: clamp(0.625rem, 0.78vw, 0.8rem)
  --sky-badge-width: clamp(6.25rem, 8.5vw, 9rem)
  --sky-guide-title-size: clamp(2.625rem, 4vw, 4.875rem)
  --sky-art-visits-opacity: 0.56
  --sky-art-archive-opacity: 0.48
  --sky-art-visits-filter: brightness(1.06) saturate(0.68) contrast(0.92)
  --sky-art-archive-filter: brightness(1.08) saturate(0.58) contrast(0.92)

/* ===== 主题相关变量（云白、天空蓝与墨蓝） =====
   浅色表面呼应插画里的白云与银白衣发，正文与交互使用深蓝保证阅读对比度。
   保留 --hue 兼容性，局部分类与图谱继续使用既有色相机制。 */
:root
  --primary: #27658B
  --page-bg: #F6FAFD
  --card-bg: transparent
  --card-bg-transparent: transparent
  --article-surface-bg: #FFFFFF
  --surface-shadow-hover: 0 0.35rem 1rem rgba(41, 74, 98, 0.10)

  --btn-content: #20384D
  --btn-regular-bg: transparent
  --btn-regular-bg-hover: #E7F1F8
  --btn-regular-bg-active: #D7E8F3

  --btn-plain-bg-hover: #E7F1F8
  --btn-plain-bg-active: #D7E8F3

  --btn-card-bg-hover: #EEF6FB
  --btn-card-bg-active: #E1EEF7

  --enter-btn-bg: transparent
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: #20384D
  --title-active: #174C70

  --line-divider: #CEDFEA
  --line-color: #CEDFEA
  --meta-divider: #9CB4C7
  --content-meta: #4C657A
  --article-pinned-accent: #27658B
  --article-title-marker: #27658B
  --article-category-lightness: 0.42
  --article-category-chroma: 0.09

  --inline-code-bg: #E7F1F8
  --inline-code-color: #20384D
  --strong-color: #14283A
  --selection-bg: #C9E3F3
  --codeblock-bg: #F0F6FA
  --codeblock-topbar-bg: #E3EFF7
  --codeblock-border: #CEDFEA

  --license-block-bg: #EEF6FB

  --link-underline: #99BFDA
  --link-hover: #174C70
  --link-active: #142F48
  --link-color: #27658B

  --float-panel-bg: #FFFFFF
  --music-surface: #E3EFF7
  --navbar-bg: #E7F1F8
  --navbar-highlight-bg: #20384D
  --navbar-highlight-text: #FFFFFF

  --scrollbar-bg-light: rgba(32, 56, 77, 0.4)
  --scrollbar-bg-hover-light: rgba(32, 56, 77, 0.5)
  --scrollbar-bg-active-light: rgba(32, 56, 77, 0.6)

  --scrollbar-bg-dark: rgba(178, 201, 220, 0.4)
  --scrollbar-bg-hover-dark: rgba(178, 201, 220, 0.5)
  --scrollbar-bg-active-dark: rgba(178, 201, 220, 0.6)

  --scrollbar-bg: var(--scrollbar-bg-light)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light)

  --display-light-icon: 1
  --display-dark-icon: 0

  --admonitions-color-tip: #3F718E
  --admonitions-color-note: #27658B
  --admonitions-color-important: #325E80
  --admonitions-color-warning: #7A6241
  --admonitions-color-caution: #A84752

  --guestbook-panel: transparent
  --guestbook-surface: transparent
  --guestbook-editor-bg: #FFFFFF
  --guestbook-editor-text: #20384D
  --guestbook-editor-muted: #4C657A
  --guestbook-editor-line: #BDD2E2
  --guestbook-editor-hover: #E7F1F8
  --guestbook-focus: #27658B
  --guestbook-send-bg: #27658B
  --guestbook-send-text: #FFFFFF
  --guestbook-link: #27658B
  --guestbook-overlay: rgb(16 29 42 / 0.58)
  --guestbook-bubble: #E3EFF7
  --guestbook-bubble-text: #20384D
  --guestbook-admin-bubble: #27658B
  --guestbook-admin-text: #FFFFFF
  --guestbook-muted: var(--content-meta)
  --guestbook-line: var(--line-divider)
  --guestbook-dock-bg: #E7F1F8
  --guestbook-danger: var(--admonitions-color-caution)
  --guestbook-success: var(--admonitions-color-tip)
  --guestbook-waiting: #A84752
  --guestbook-avatar-size: 2.625rem
  --guestbook-chat-max-width: 64rem
  --guestbook-sidebar-width: 18rem
  --guestbook-viewport-offset: 4.75rem
  --guestbook-mobile-dock-clearance: 6.25rem

  /* TOC 极简：去 badge 底色、hover 仅细线反相 */
  --toc-badge-bg: transparent
  --toc-btn-hover: #E7F1F8
  --toc-btn-active: #D7E8F3
  --toc-width: 18rem
  --toc-item-active: #20384D

  --color-selection-bar: linear-gradient(to right, #20384D, #6A9DBC, #D5EAF6)

  /* 标签关系图谱：画布跟随主题，仅节点分组保留低饱和色 */
  --tag-graph-surface: #FFFFFF
  --tag-graph-text: #20384D
  --tag-graph-muted: #4C657A
  --tag-graph-tooltip-bg: rgba(32, 56, 77, 0.96)
  --tag-graph-tooltip-text: #F6FAFD
  --tag-graph-tooltip-border: rgba(255, 255, 255, 0.16)
  --tag-graph-node-1: #d84f4b
  --tag-graph-node-2: #3f7cac
  --tag-graph-node-3: #4f9d8f
  --tag-graph-node-4: #d39b2a
  --tag-graph-node-5: #8a68a6
  --tag-graph-node-6: #b86b43
  --tag-graph-node-7: #668f3f
  --tag-graph-node-8: #8a7470

  /* 中天空蓝在云白与墨蓝表面均有清楚的图形对比度，供勾选与导览聚焦使用 */
  --graph-chip-checked: #5086A8

  /* 7 色彩虹渐变（红橙黄绿青蓝紫），用于幽灵徽章文字 */
  --rainbow-red: #FF5252
  --rainbow-orange: #FF9800
  --rainbow-yellow: #FFEB3B
  --rainbow-green: #4CAF50
  --rainbow-cyan: #00BCD4
  --rainbow-blue: #2196F3
  --rainbow-purple: #9C27B0
  --rainbow-7: linear-gradient(135deg, var(--rainbow-red) 0%, var(--rainbow-orange) 16%, var(--rainbow-yellow) 33%, var(--rainbow-green) 50%, var(--rainbow-cyan) 66%, var(--rainbow-blue) 83%, var(--rainbow-purple) 100%)

/* 卡片"跟随主题色相"模式被废弃为 no-op */
:root:not(.dark) body.card-follow-theme-hue
  --card-bg: transparent

/* 暗色主题：夜蓝页面承接白天的天空，银白正文与浅蓝交互保持独立层级。
   页面 #101D2A → 表面 #172A3A → 悬停 #21384B → 激活 #2A465D。 */
:root.dark
  --primary: #A6CDE7
  --page-bg: #101D2A
  --card-bg: transparent
  --card-bg-transparent: transparent
  --article-surface-bg: #172A3A
  --surface-shadow-hover: 0 0.35rem 1rem rgba(0, 8, 18, 0.28)
  --sky-art-visits-opacity: 0.28
  --sky-art-archive-opacity: 0.25
  --sky-art-visits-filter: brightness(0.84) saturate(0.55)
  --sky-art-archive-filter: brightness(0.86) saturate(0.55)

  --deep-text: #E4EDF4
  --title-active: #B7D7EB

  --btn-content: #E4EDF4
  --btn-regular-bg: transparent
  --btn-regular-bg-hover: #21384B
  --btn-regular-bg-active: #2A465D

  --btn-plain-bg-hover: #21384B
  --btn-plain-bg-active: #2A465D

  --btn-card-bg-hover: #21384B
  --btn-card-bg-active: #2A465D

  --line-divider: #304C61
  --line-color: #304C61
  --meta-divider: #456278
  --content-meta: #A8BBCB
  --article-pinned-accent: #A6CDE7
  --article-title-marker: #8CBBDC
  --article-category-lightness: 0.75
  --article-category-chroma: 0.09

  --inline-code-bg: #273F53
  --inline-code-color: #E4EDF4
  --strong-color: #F6FAFD
  --selection-bg: #355872
  --codeblock-bg: #122231
  --codeblock-topbar-bg: #172A3A
  --codeblock-border: #304C61

  --license-block-bg: #172A3A

  --link-underline: #4F7591
  --link-hover: #D4E9F7
  --link-active: #F6FAFD
  --link-color: #A6CDE7

  --float-panel-bg: #172A3A
  --music-surface: #172A3A
  --navbar-bg: #172A3A
  --navbar-highlight-bg: #D8E8F3
  --navbar-highlight-text: #14283A

  --scrollbar-bg: var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark)

  --display-light-icon: 0
  --display-dark-icon: 1

  --admonitions-color-tip: #A6CDE7
  --admonitions-color-note: #A6CDE7
  --admonitions-color-important: #B7CBE0
  --admonitions-color-warning: #D8C59C
  --admonitions-color-caution: #EEA5AE

  --guestbook-panel: transparent
  --guestbook-surface: transparent
  --guestbook-editor-bg: #21384B
  --guestbook-editor-text: #E4EDF4
  --guestbook-editor-muted: #A8BBCB
  --guestbook-editor-line: #4F7089
  --guestbook-editor-hover: #2A465D
  --guestbook-focus: #A6CDE7
  --guestbook-send-bg: #A6CDE7
  --guestbook-send-text: #14283A
  --guestbook-link: #A6CDE7
  --guestbook-overlay: rgb(16 29 42 / 0.72)
  --guestbook-bubble: #21384B
  --guestbook-bubble-text: #E4EDF4
  --guestbook-admin-bubble: #A6CDE7
  --guestbook-admin-text: #14283A
  --guestbook-muted: var(--content-meta)
  --guestbook-line: var(--line-divider)
  --guestbook-dock-bg: #172A3A
  --guestbook-danger: var(--admonitions-color-caution)
  --guestbook-success: var(--admonitions-color-tip)
  --guestbook-waiting: #EEA5AE

  --toc-badge-bg: transparent
  --toc-btn-hover: #21384B
  --toc-btn-active: #2A465D
  --toc-item-active: #E4EDF4

  --color-selection-bar: linear-gradient(to right, #D8E8F3, #6A9DBC, #273F53)

  --tag-graph-surface: #172A3A
  --tag-graph-text: #E4EDF4
  --tag-graph-muted: #A8BBCB
  --tag-graph-tooltip-bg: rgba(23, 42, 58, 0.96)
  --tag-graph-tooltip-text: #E4EDF4
  --tag-graph-tooltip-border: rgba(178, 201, 220, 0.18)
  --tag-graph-node-1: #e25552
  --tag-graph-node-2: #5c91c2
  --tag-graph-node-3: #59aaa0
  --tag-graph-node-4: #e0ae3a
  --tag-graph-node-5: #a57abc
  --tag-graph-node-6: #d17a4e
  --tag-graph-node-7: #7bac54
  --tag-graph-node-8: #ad9189

  --graph-chip-checked: #5086A8

/* ===== 友链卡片彩色调色板（Cute Doodle Palette） ===== */
:root
  --fc-ink: #2c2c2c
  --fc-text: var(--fc-ink)
  --fc-outline: var(--fc-ink)
  --fc-shadow: var(--fc-ink)
  --fc-intro-bg: #c6e377
  --fc-intro-text: var(--fc-ink)
  --fc-tape-text: var(--fc-ink)
  --fc-accent-coral: #ff8ba7
  --fc-accent-mint: #c6e377
  --fc-accent-lavender: #c0bbfe
  --fc-accent-yellow: #ffdf6c
  --fc-tape-color: rgba(255, 221, 161, 0.85)
  --fc-paper-bg: #f5edd6
  --fc-paper-line: #ddd2b8

:root.dark
  --fc-ink: #f3eff8
  --fc-text: var(--fc-ink)
  --fc-outline: #777187
  --fc-shadow: #15131c
  --fc-intro-bg: #3d4a41
  --fc-intro-text: #eff5ec
  --fc-tape-text: #f3eff8
  --fc-accent-coral: #d7839c
  --fc-accent-mint: #8fae7b
  --fc-accent-lavender: #a79add
  --fc-accent-yellow: #d8b965
  --fc-tape-color: #7d6647
  --fc-paper-bg: #242331
  --fc-paper-line: #37354a

/* ===== 阴影变量（仅保留实际使用的） ===== */
:root
  --shadow-md: none
  --shadow-navbar: none
  --shadow-navbar-dark: none

/* ===== 边框半径变量 ===== */
:root
  --radius-full: 9999px
