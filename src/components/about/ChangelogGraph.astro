---
import { getEntry } from "astro:content";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	buildChangelogLinks,
	type ChangelogType,
	PAGE_META,
	parseChangelogMarkdown,
	renderChangelogDetail,
} from "@/utils/changelog";
import "@/styles/components/about-changelog.css";

const logDoc = await getEntry("spec", "log");
const entries = parseChangelogMarkdown(logDoc?.body ?? "");
const CHANGELOG_DISPLAY_LIMIT = 30;
const total = entries.length;
const visibleEntries = entries.slice(0, CHANGELOG_DISPLAY_LIMIT);
const hiddenEntryCount = total - visibleEntries.length;
const links = buildChangelogLinks(visibleEntries);
const recentLimitMessage = i18n(I18nKey.aboutChangelogRecentLimit).replace(
	"{count}",
	String(CHANGELOG_DISPLAY_LIMIT),
);

const typeLabels: Record<ChangelogType, string> = {
	feat: i18n(I18nKey.changelogTypeFeat),
	fix: i18n(I18nKey.changelogTypeFix),
	style: i18n(I18nKey.changelogTypeStyle),
	refactor: i18n(I18nKey.changelogTypeRefactor),
	chore: i18n(I18nKey.changelogTypeChore),
};

const pageLabels = Object.fromEntries(
	Object.entries(PAGE_META).map(([key, meta]) => [key, meta.label]),
);
---

<div
	class="changelog"
	data-changelog
	data-page-labels={JSON.stringify(pageLabels)}
	data-shared-prefix={i18n(I18nKey.aboutChangelogPagesLabel)}
>
	<div class="changelog__heading">
		<h2 class="changelog__section-title">
			{i18n(I18nKey.aboutChangelogTitle)}
		</h2>
		{
			hiddenEntryCount > 0 && (
				<span class="changelog__recent-limit">{recentLimitMessage}</span>
			)
		}
	</div>

	<svg class="changelog__wires" data-changelog-wires aria-hidden="true">
		<defs>
			<marker
				id="changelog-arrow"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="6.5"
				markerHeight="6.5"
				orient="auto-start-reverse"
			>
				<path
					d="M2 1L8 5L2 9"
					fill="none"
					stroke="context-stroke"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</marker>
		</defs>
	</svg>

	{total === 0 && <p class="changelog__empty">{i18n(I18nKey.aboutChangelogEmpty)}</p>}
	<ol class="changelog__grid" data-changelog-grid>
		{
			visibleEntries.map((entry, i) => {
				const num = total - i;
				const entryLinks = links.get(i) ?? [];
				return (
					<li
						class="changelog-card"
						data-changelog-card
						data-index={i}
						data-num={num}
						data-type={entry.type}
						data-links={JSON.stringify(entryLinks)}
					>
						<button
							type="button"
							class="changelog-card__inner"
							data-changelog-open
							aria-haspopup="dialog"
							aria-controls="changelog-dialog"
							aria-labelledby={`changelog-title-${i}`}
							aria-describedby={`changelog-meta-${i} changelog-summary-${i}`}
						>
							<span class="changelog-card__num" aria-hidden="true">
								{String(num).padStart(2, "0")}
							</span>
							<span class="changelog-card__meta" id={`changelog-meta-${i}`}>
								<span class="changelog-card__type">{typeLabels[entry.type]}</span>
								<time class="changelog-card__date" datetime={entry.date}>
									{entry.date}
								</time>
							</span>
							<span class="changelog-card__title" id={`changelog-title-${i}`}>{entry.title}</span>
							<span class="changelog-card__summary" id={`changelog-summary-${i}`}>{entry.summary}</span>
						</button>
						<div class="changelog-card__detail" hidden>
							<div class="changelog-card__detail-body" set:html={renderChangelogDetail(entry.detail)} />
							<div class="changelog-card__pages">
								{entry.pages.map((page) => {
									const meta = PAGE_META[page];
									if (!meta) return null;
									return meta.url ? (
										<a class="changelog-card__page-chip" href={meta.url}>
											{meta.label}
										</a>
									) : (
										<span class="changelog-card__page-chip">{meta.label}</span>
									);
								})}
							</div>
						</div>
					</li>
				);
			})
		}
	</ol>

	<dialog class="changelog-dialog" id="changelog-dialog" data-changelog-dialog aria-labelledby="changelog-dialog-title">
		<div
			class="changelog-dialog__panel"
		>
			<button
				type="button"
				class="changelog-dialog__close"
				data-changelog-close
				aria-label={i18n(I18nKey.close)}
			>
				&times;
			</button>
			<div class="changelog-dialog__meta">
				<span class="changelog-dialog__num" data-dialog-num></span>
				<span class="changelog-dialog__type" data-dialog-type></span>
				<time class="changelog-dialog__date" data-dialog-date></time>
			</div>
			<h3 class="changelog-dialog__title" id="changelog-dialog-title" data-dialog-title></h3>
			<div class="changelog-dialog__detail" data-dialog-detail></div>
			<div class="changelog-dialog__section">
				<span class="changelog-dialog__label">
					{i18n(I18nKey.aboutChangelogPagesLabel)}
				</span>
				<div class="changelog-dialog__pages" data-dialog-pages></div>
			</div>
			<div class="changelog-dialog__section" data-dialog-related-section>
				<span class="changelog-dialog__label">
					{i18n(I18nKey.aboutChangelogRelatedLabel)}
				</span>
				<ul class="changelog-dialog__related" data-dialog-related></ul>
			</div>
		</div>
	</dialog>
</div>

<script>
	import { registerChangelogGraph } from "@/utils/changelog-controller";

	registerChangelogGraph();
</script>
