---
import HeroContact from "@components/layout/HeroContact.astro";
import HeroDialogue from "@components/layout/HeroDialogue.astro";
import HeroMosaic from "@components/layout/HeroMosaic.astro";
import { homeConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const { hero } = homeConfig;
// 桌面首屏使用角色署名，不改变全站作者名或移动端身份。
const characterName = "Shirayukihime";
const occupation = (homeConfig.occupation || "")
	.replace(/^\[/, "【")
	.replace(/\]$/, "】");
const blogTitle = `${homeConfig.name}的博客`;
const dialogueEnabled =
	hero.dialogue?.enabled !== false && Boolean(hero.dialogue);
const runtimeConfig = {
	mosaic: hero.mosaic,
	artwork: hero.artwork,
	rain: {
		enabled: hero.rain?.enabled ?? true,
		intensity: hero.rain?.intensity ?? 0.6,
		color: hero.rain?.color ?? "",
	},
};
const artworkStyle = [
	`--home-hero-art-position-x: ${hero.artwork.positionX * 100}%`,
	`--home-hero-art-position-y: ${hero.artwork.positionY * 100}%`,
	`--home-hero-art-aspect: ${hero.artwork.width / hero.artwork.height}`,
	`--home-hero-art-width: ${hero.artwork.width}px`,
	`--home-hero-art-height: ${hero.artwork.height}px`,
	`--home-hero-art-align-x: ${hero.artwork.positionX}`,
	`--home-hero-art-align-y: ${hero.artwork.positionY}`,
].join(";");
---

<section
	class="home-hero"
	id="home-hero"
	data-home-hero
	data-signature-paused="true"
	data-hero-config={JSON.stringify(runtimeConfig)}
	style={artworkStyle}
>
	<HeroMosaic
		desktopImage={hero.backgroundImage}
		mobileImage={hero.backgroundImage}
		config={hero.mosaic}
		artwork={hero.artwork}
	/>

	<div class="home-hero__shade" aria-hidden="true"></div>
	<div class="home-hero__opening" data-hero-opening aria-hidden="true"></div>

	<header class="home-hero__identity" data-hero-title>
		{occupation && (
			<p class="home-hero__occupation"><span>{occupation}</span></p>
		)}
		<h1 class="home-hero__title">
			<span class="home-hero__title-name" aria-hidden="true">
				<span class="home-hero__title-word">{characterName}</span>
			</span>
			<span class="sr-only">{characterName}{ i18n(I18nKey.techBlogSuffix) }</span>
		</h1>
		<button class="home-hero__name-badge" type="button" data-dialogue-restore aria-controls="hero-dialogue">
			<span class="home-hero__name-badge-text">{blogTitle}</span>
		</button>
	</header>

	{hero.contact && <HeroContact contact={hero.contact} />}

	<div class="home-hero__interaction">
		{dialogueEnabled && hero.dialogue && (
			<HeroDialogue
				config={hero.dialogue}
				sticker={hero.sticker}
				authorAvatarImage={hero.authorAvatarImage}
				fallbackHostName={homeConfig.displayName || homeConfig.name}
			/>
		)}
	</div>

	<noscript>
		<span class="home-hero__static" hidden></span>
	</noscript>

	<canvas class="home-hero__rain" data-hero-rain aria-hidden="true"></canvas>
</section>

<script>
	import { mountHomeHero } from "@/utils/home-hero-controller";
	import { bindHomeLayer } from "@/utils/home-lifecycle";

	let cleanupHomeHero: (() => void) | null = null;

	// 挂载时机与去重全部交给 bindHomeLayer：顶层自启和 astro:page-load 谁先谁后都只挂一次，
	// 否则第二次挂载会把第一次那条 document.fonts.ready 回调放进来，contact 被拆成两套字符节点
	bindHomeLayer("hero", {
		boot: () => {
			cleanupHomeHero?.();
			cleanupHomeHero = mountHomeHero();
		},
		teardown: () => {
			cleanupHomeHero?.();
			cleanupHomeHero = null;
		},
	});
</script>
