---

<svg
	class="site-footer__signature-art"
	viewBox="0 0 450 140"
	fill="none"
	role="img"
	aria-labelledby="site-footer-signature-title"
	data-footer-signature
>
	<title id="site-footer-signature-title">SoraGinko</title>
	<defs>
		<mask id="soraginko-footer-signature-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="450" height="140">
			<path
				class="site-footer__signature-mask"
				d={signaturePath}
				pathLength="1"
				stroke="white"
				stroke-width="22"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</mask>
	</defs>
	<path
		class="site-footer__signature-ink"
		d={signaturePath}
		mask="url(#soraginko-footer-signature-mask)"
		stroke="currentColor"
		stroke-width="6"
		stroke-linecap="round"
		stroke-linejoin="round"
	/>
	<path
		class="site-footer__signature-dot site-footer__signature-dot--i"
		d="M264 50L265 47"
		stroke="currentColor"
		stroke-width="6"
		stroke-linecap="round"
	/>
</svg>
