---
import Icon from "@components/common/Icon.astro";
import FooterSignature from "@components/layout/FooterSignature.astro";
import dayjs from "dayjs";
import { footerConfig, homeConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatDateI18n } from "@/utils/date-utils";
import { url } from "@/utils/url-utils";

const FOOTER_TIME = {
	millisecondsPerSecond: 1_000,
	secondsPerMinute: 60,
	secondsPerHour: 3_600,
	secondsPerDay: 86_400,
};
const buildDate = dayjs();
const buildTimestamp = buildDate.valueOf();
const currentYear = buildDate.year();
const siteStartDate = siteConfig.siteStartDate || "";
const { socialLinks, beian, poweredBy, moeIcp } = footerConfig;
const bioText = Array.isArray(homeConfig.bio)
	? homeConfig.bio[0] || ""
	: homeConfig.bio || "";

function getSiteStartTimestamp(value: string): number | null {
	if (!value) return null;

	const normalizedValue = /^\d{4}-\d{2}-\d{2}$/.test(value)
		? `${value}T00:00:00+08:00`
		: value;
	const parsedDate = dayjs(normalizedValue);
	if (!parsedDate.isValid()) return null;
	// Day.js 会把 2 月 31 日等日期顺延，配置日期必须保持原有年月日。
	const calendarDate = value.slice(0, 10);
	if (
		!/^\d{4}-\d{2}-\d{2}$/.test(calendarDate) ||
		dayjs(calendarDate).format("YYYY-MM-DD") !== calendarDate
	)
		return null;
	const timestamp = parsedDate.valueOf();

	return timestamp > buildTimestamp ? null : timestamp;
}

const startTimestamp = getSiteStartTimestamp(siteStartDate);
const runningTimeText = i18n(I18nKey.footerRunningTime);
const lastUpdateText = i18n(I18nKey.footerLastUpdate);
const startPendingText = i18n(I18nKey.footerStartPending);
const updatedTodayText = i18n(I18nKey.footerUpdatedToday);

function formatInitialRunningTime(
	template: string,
	elapsedSeconds: number,
): string {
	const days = Math.floor(elapsedSeconds / FOOTER_TIME.secondsPerDay);
	const hours = Math.floor(
		(elapsedSeconds % FOOTER_TIME.secondsPerDay) / FOOTER_TIME.secondsPerHour,
	);
	const minutes = Math.floor(
		(elapsedSeconds % FOOTER_TIME.secondsPerHour) /
			FOOTER_TIME.secondsPerMinute,
	);
	const seconds = elapsedSeconds % FOOTER_TIME.secondsPerMinute;

	return template
		.replace("{days}", days.toString())
		.replace("{hours}", hours.toString())
		.replace("{minutes}", minutes.toString())
		.replace("{seconds}", seconds.toString());
}

const initialRunningTime =
	startTimestamp === null
		? startPendingText
		: formatInitialRunningTime(
				runningTimeText,
				Math.floor(
					(buildTimestamp - startTimestamp) / FOOTER_TIME.millisecondsPerSecond,
				),
			);

// mailto:/tel: 链接不在新标签打开
const opensInNewTab = (href: string) => !/^(mailto:|tel:)/i.test(href);
---

<footer
	class="footer site-footer"
	data-site-footer
	data-start-timestamp={startTimestamp ?? undefined}
	data-updated-timestamp={buildTimestamp}
>
	<div class="site-footer__inner">
		<div class="site-footer__primary">
			<section class="site-footer__brand" aria-label={homeConfig.name}>
				<div class="site-footer__brand-copy">
					<FooterSignature />
					{bioText && <p class="site-footer__tagline">{bioText}</p>}
				</div>
			</section>

			<nav class="site-footer__contact" aria-label={i18n(I18nKey.contactMethods)}>
				<p class="site-footer__eyebrow">{i18n(I18nKey.contactMethods)}</p>
				<ul class="site-footer__social-list" role="list">
					{socialLinks.map((link) => (
						<li>
							<a
								class="site-footer__social-link"
								href={link.href}
								target={opensInNewTab(link.href) ? "_blank" : undefined}
								rel={opensInNewTab(link.href) ? "noreferrer" : undefined}
								aria-label={link.label}
								data-tooltip={link.label}
							>
								<Icon name={link.icon} is:inline aria-hidden="true" />
							</a>
						</li>
					))}
				</ul>
				<div class="site-footer__utility-links">
					<a href={url("sitemap-index.xml")} target="_blank" rel="noreferrer">Sitemap</a>
					<span aria-hidden="true">/</span>
					<a href={url("rss/")} target="_blank" rel="noreferrer">RSS</a>
					<span aria-hidden="true">/</span>
					<button
						class="site-footer__utility-button"
						onclick="window.openPrivacyModal && window.openPrivacyModal()"
						type="button"
					>
						{i18n(I18nKey.privacyPolicy)}
					</button>
					<span aria-hidden="true">/</span>
					<button
						class="site-footer__utility-button"
						onclick="window.openUserAgreementModal && window.openUserAgreementModal()"
						type="button"
					>
						{i18n(I18nKey.userAgreement)}
					</button>
				</div>
			</nav>
		</div>

		<div class="site-footer__lower">
			<div class="site-footer__legal">
				<div class="site-footer__copyright-row">
					<p class="site-footer__copyright">&copy; {currentYear} {homeConfig.name}</p>
					{poweredBy.map((item) => (
						<>
							<span class="site-footer__copyright-divider" aria-hidden="true">·</span>
							<span class="site-footer__powered-by">
								<span>{item.label}</span>
								<a href={item.href} target="_blank" rel="noreferrer">{item.name}</a>
							</span>
						</>
					))}
				</div>
				{moeIcp.enabled && <div class="site-footer__beian"><a href={moeIcp.url} target="_blank" rel="noopener noreferrer">{moeIcp.text}</a></div>}
				{(beian.icp || beian.police) && (
					<div class="site-footer__beian">
						{beian.icp && (
							<a href={beian.icpUrl} target="_blank" rel="noreferrer">{beian.icp}</a>
						)}
						{beian.icp && beian.police && <span aria-hidden="true">/</span>}
						{beian.police && (
							<a
								class="site-footer__police-link"
								href={beian.policeUrl}
								target="_blank"
								rel="noreferrer"
							>
								<img src={beian.policeIcon} alt={i18n(I18nKey.policeBeianAlt)} />
								<span>{beian.police}</span>
							</a>
						)}
					</div>
				)}
			</div>

			<div class="site-footer__status">
				<p class="site-footer__status-line">
					<Icon name="material-symbols:calendar-clock-outline" is:inline aria-hidden="true" />
					<span data-footer-running-time data-template={runningTimeText} data-pending={startPendingText}>{initialRunningTime}</span>
				</p>
				<p class="site-footer__status-line">
					<Icon name="mingcute:heartbeat-line" is:inline aria-hidden="true" />
					<span data-footer-last-update data-template={lastUpdateText} data-today={updatedTodayText} title={formatDateI18n(buildDate.toDate(), true)}>{updatedTodayText}</span>
				</p>
			</div>
		</div>
	</div>
</footer>

<script>
	import dayjs from "dayjs";
	import { definePersistentIsland } from "@/utils/swup-lifecycle";

	const FOOTER_TIME = {
		millisecondsPerSecond: 1_000,
		secondsPerMinute: 60,
		secondsPerHour: 3_600,
		secondsPerDay: 86_400,
	};

	function formatRunningTime(template: string, elapsedSeconds: number): string {
		const days = Math.floor(elapsedSeconds / FOOTER_TIME.secondsPerDay);
		const hours = Math.floor((elapsedSeconds % FOOTER_TIME.secondsPerDay) / FOOTER_TIME.secondsPerHour);
		const minutes = Math.floor((elapsedSeconds % FOOTER_TIME.secondsPerHour) / FOOTER_TIME.secondsPerMinute);
		const seconds = elapsedSeconds % FOOTER_TIME.secondsPerMinute;
		return template
			.replace("{days}", days.toString())
			.replace("{hours}", hours.toString())
			.replace("{minutes}", minutes.toString())
			.replace("{seconds}", seconds.toString());
	}

	definePersistentIsland("footer", () => {
		const footer = document.querySelector<HTMLElement>("[data-site-footer]");
		if (!footer) return;
		const runningTimeElement = footer.querySelector<HTMLElement>("[data-footer-running-time]");
		const lastUpdateElement = footer.querySelector<HTMLElement>("[data-footer-last-update]");
		const startTimestamp = footer.dataset.startTimestamp ? Number(footer.dataset.startTimestamp) : Number.NaN;
		const updatedTimestamp = footer.dataset.updatedTimestamp ? Number(footer.dataset.updatedTimestamp) : Number.NaN;
		let intervalId: number | undefined;
		let isInView = false;
		let signatureObserver: IntersectionObserver | null = null;
		const signature = footer.querySelector<SVGElement>("[data-footer-signature]");

		const updateFooterStats = () => {
			const now = dayjs().valueOf();
			if (runningTimeElement) {
				const template = runningTimeElement.dataset.template || "";
				runningTimeElement.textContent = Number.isSafeInteger(startTimestamp) && startTimestamp <= now
					? formatRunningTime(template, Math.floor((now - startTimestamp) / FOOTER_TIME.millisecondsPerSecond))
					: runningTimeElement.dataset.pending || "";
			}
			// 构建时间由服务端生成；本机时钟若落后，不把未来时间强行算成 0 天。
			if (lastUpdateElement && Number.isSafeInteger(updatedTimestamp) && updatedTimestamp <= now) {
				const days = Math.floor((now - updatedTimestamp) / (FOOTER_TIME.secondsPerDay * FOOTER_TIME.millisecondsPerSecond));
				lastUpdateElement.textContent = days === 0
					? lastUpdateElement.dataset.today || ""
					: (lastUpdateElement.dataset.template || "").replace("{days}", days.toString());
			}
		};
		const stop = () => {
			if (intervalId !== undefined) window.clearInterval(intervalId);
			intervalId = undefined;
		};
		const syncPlayback = () => {
			stop();
			if (!isInView || document.hidden) return;
			updateFooterStats();
			intervalId = window.setInterval(updateFooterStats, FOOTER_TIME.millisecondsPerSecond);
		};
		const footerObserver = new IntersectionObserver((entries) => {
			isInView = entries.some((entry) => entry.isIntersecting);
			syncPlayback();
		});
		footerObserver.observe(footer);

		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (signature && !reducedMotion) {
			footer.classList.add("is-signature-pending");
			signatureObserver = new IntersectionObserver((entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				footer.classList.add("is-signature-drawn");
				signatureObserver?.disconnect();
			}, { threshold: 0.35 });
			signatureObserver.observe(signature);
		}

		const onPageShow = (event: PageTransitionEvent) => {
			if (!event.persisted) return;
			footerObserver.observe(footer);
			if (signature && !footer.classList.contains("is-signature-drawn")) signatureObserver?.observe(signature);
		};
		const onPageHide = (event: PageTransitionEvent) => {
			stop();
			isInView = false;
			footerObserver.disconnect();
			signatureObserver?.disconnect();
			if (event.persisted) return;
			document.removeEventListener("visibilitychange", syncPlayback);
			window.removeEventListener("pageshow", onPageShow);
			window.removeEventListener("pagehide", onPageHide);
		};
		document.addEventListener("visibilitychange", syncPlayback);
		window.addEventListener("pageshow", onPageShow);
		window.addEventListener("pagehide", onPageHide);
	});
</script>
