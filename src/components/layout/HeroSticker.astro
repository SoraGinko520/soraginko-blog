---
import type { HeroStickerConfig } from "@/types/config";

interface Props {
	config: HeroStickerConfig;
}

const { config } = Astro.props;
---

<figure
	class="home-hero__sticker"
	style={`--home-hero-sticker-frames: ${config.frameCount}`}
	data-hero-sticker
	data-frame-count={config.frameCount}
	data-expression="idle"
>
	<img
		class="home-hero__sticker-image"
		data-hero-sticker-image
		src={config.image}
		alt={config.alt}
		width={config.frameSize * config.frameCount}
		height={config.frameSize}
		loading="eager"
		decoding="async"
		draggable="false"
	/>
</figure>
