---
import { Picture } from "astro:assets";
import * as path from "node:path";
import Icon from "@components/common/Icon.astro";
import type { ImageMetadata } from "astro";
import { siteConfig } from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { url } from "@/utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const processedLinks = Astro.props.links.map((link: NavBarLink) => ({
	...link,
	children: link.children?.map((child: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof child === "number") {
			return LinkPresets[child];
		}
		return child;
	}),
}));

// Logo 加载逻辑（与 Navbar 一致，用于移动端抽屉顶部品牌区）
const navbarTitle = siteConfig.navbar.title || siteConfig.title;
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) logoImg = await file();
}
---

<div id="nav-drawer-overlay" class="nav-drawer-overlay" aria-hidden="true"></div>

<div id="nav-menu-panel" class="nav-drawer" role="dialog" aria-modal="true" aria-labelledby="nav-drawer-title" aria-hidden="true" tabindex="-1" inert>
	<a href={url('/')} class="nav-drawer-brand">
		{siteConfig.navbar.logo?.type === "icon" ? (
			<Icon name={siteConfig.navbar.logo.value || "material-symbols:home-pin-outline"} is:inline class="text-[1.5rem] flex-shrink-0" />
		) : siteConfig.navbar.logo?.type === "image" && logoImg ? (
			logoImg.format === "svg" ? (
				<img src={logoImg.src} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="nav-drawer-brand-logo" />
			) : (
				<Picture
					src={logoImg}
					alt={siteConfig.navbar.logo.alt || siteConfig.title}
					class="nav-drawer-brand-logo"
					formats={getImageFormats()}
					fallbackFormat={getFallbackFormat()}
					widths={[36, 72]}
					loading="eager"
				/>
			)
		) : siteConfig.navbar.logo?.type === "image" ? (
			<img src={url(siteConfig.navbar.logo.value)} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="nav-drawer-brand-logo" />
		) : siteConfig.navbar.logo?.type === "url" ? (
			<img src={siteConfig.navbar.logo.value} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="nav-drawer-brand-logo" />
		) : (
			<Icon name="material-symbols:home-pin-outline" is:inline class="text-[1.5rem] flex-shrink-0" />
		)}
		<span class="nav-drawer-brand-text">{navbarTitle}</span>
	</a>

	<div class="nav-drawer-header">
		<span id="nav-drawer-title" class="nav-drawer-title font-mono uppercase tracking-[0.15em] text-sm font-semibold">Menu</span>
		<button type="button" aria-label="Close menu" id="nav-drawer-close" class="nav-drawer-close-btn">
			<Icon name="material-symbols:close-rounded" is:inline class="text-[1.5rem]" />
		</button>
	</div>

	<nav class="nav-drawer-body">
		{processedLinks.map((link, index) => (
			<div
				class="nav-drawer-item"
				style={`--item-index: ${index}`}
			>
				{link.children && link.children.length > 0 ? (
					<div class="mobile-dropdown">
						<div class="nav-drawer-link group nav-drawer-section-title">
							<div class="flex items-center gap-3">
								<span class="nav-drawer-link-text">{link.name}</span>
							</div>
						</div>
						<div class="mobile-submenu mobile-submenu--flat">
							{link.children.map((child) => {
								if (child.action) {
									return <button type="button" class="nav-drawer-sublink group" data-action={child.action}><div class="flex items-center gap-3">{child.icon && <Icon name={child.icon} is:inline class="text-[1.1rem]" />}<span>{child.name}</span></div></button>;
								}
								return <a href={child.external ? child.url : url(child.url)} class="nav-drawer-sublink group" target={child.external ? "_blank" : null}><div class="flex items-center gap-3">{child.icon && <Icon name={child.icon} is:inline class="text-[1.1rem]" />}<span>{child.name}</span></div>{child.external && <Icon name="fa7-solid:arrow-up-right-from-square" is:inline class="text-[0.7rem] text-black/25 dark:text-white/25" />}</a>;
							})}
						</div>
					</div>
				) : (
					<a href={link.external ? link.url : url(link.url)}
						class="nav-drawer-link group"
						target={link.external ? "_blank" : null}
					>
						<div class="flex items-center gap-3">
							{link.icon && <Icon name={link.icon} is:inline class="text-[1.25rem] nav-drawer-icon" />}
							<span class="nav-drawer-link-text">{link.name}</span>
						</div>
						{link.external && <Icon name="fa7-solid:arrow-up-right-from-square" is:inline
							class="text-[0.7rem] text-black/25 dark:text-white/25"
						/>}
					</a>
				)}
			</div>
		))}
	</nav>
</div>

<!-- 样式已迁移至 src/styles/layout/nav-menu-panel.css -->

<script>
import { definePersistentIsland, onBeforeSwap } from "@/utils/swup-lifecycle";

function initNavDrawer() {
	const panelEl = document.getElementById('nav-menu-panel');
	const overlayEl = document.getElementById('nav-drawer-overlay');
	const menuBtn = document.getElementById('nav-menu-switch');
	const closeBtn = document.getElementById('nav-drawer-close');

	if (!panelEl || !overlayEl) return;

	const panel = panelEl;
	const overlay = overlayEl;
	const abortController = new AbortController();
	const { signal } = abortController;
	const drawerMedia = window.matchMedia('(min-width: 769px) and (max-width: 1023px)');
	let previousBodyOverflow = '';
	menuBtn?.setAttribute('aria-controls', panel.id);
	menuBtn?.setAttribute('aria-expanded', 'false');

	function openDrawer() {
		if (!drawerMedia.matches || panel.classList.contains('is-open')) return;
		previousBodyOverflow = document.body.style.overflow;
		panel.inert = false;
		panel.setAttribute('aria-hidden', 'false');
		menuBtn?.setAttribute('aria-expanded', 'true');
		panel.classList.add('is-open');
		overlay.classList.add('is-open');
		overlay.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
		(closeBtn ?? panel).focus({ preventScroll: true });
	}

	function closeDrawer(restoreFocus = true) {
		const wasOpen = panel.classList.contains('is-open');
		panel.classList.remove('is-open');
		panel.inert = true;
		panel.setAttribute('aria-hidden', 'true');
		menuBtn?.setAttribute('aria-expanded', 'false');
		overlay.classList.remove('is-open');
		overlay.setAttribute('aria-hidden', 'true');
		if (wasOpen) {
			document.body.style.overflow = previousBodyOverflow;
			if (restoreFocus) menuBtn?.focus({ preventScroll: true });
		}
	}

	closeDrawer(false);

	if (menuBtn) {
		menuBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = panel.classList.contains('is-open');
			if (isOpen) {
				closeDrawer();
			} else {
				openDrawer();
			}
		}, { signal });
	}

	if (closeBtn) {
		closeBtn.addEventListener('click', () => closeDrawer(), { signal });
	}

	overlay.addEventListener('click', () => closeDrawer(), { signal });

	// 处理 action 按钮
	panel.addEventListener('click', (e) => {
		if (!(e.target instanceof Element)) return;
		const actionBtn = e.target.closest('[data-action]');
		if (actionBtn) {
			const action = actionBtn.getAttribute('data-action');
			if (action) {
				window.dispatchEvent(new CustomEvent(action));
				closeDrawer();
			}
		}
		if (e.target.closest('a[href]')) closeDrawer(false);
	}, { signal });

	document.addEventListener('keydown', (e) => {
		if (!panel.classList.contains('is-open')) return;
		if (e.key === 'Escape') {
			e.preventDefault();
			closeDrawer();
			return;
		}
		if (e.key !== 'Tab') return;
		const focusable = [...panel.querySelectorAll<HTMLElement>(
			'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
		)];
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		if (!first || !last) {
			e.preventDefault();
			panel.focus({ preventScroll: true });
		} else if (e.shiftKey && document.activeElement === first) {
			e.preventDefault();
			last.focus({ preventScroll: true });
		} else if (!e.shiftKey && document.activeElement === last) {
			e.preventDefault();
			first.focus({ preventScroll: true });
		}
	}, { signal });
	drawerMedia.addEventListener('change', () => {
		if (!drawerMedia.matches) closeDrawer(false);
	}, { signal });
	onBeforeSwap(() => closeDrawer(false), { signal });
	window.addEventListener('pagehide', (event) => {
		closeDrawer(false);
		if (!event.persisted) abortController.abort();
	}, { signal });
}

// 抽屉 DOM 位于 Swup 容器之外，监听只安装一次；换页前释放滚动锁。
definePersistentIsland("nav-menu-panel", initNavDrawer);
</script>
