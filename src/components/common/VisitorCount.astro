---
import Icon from "@components/common/Icon.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

export interface Props {
	isHome?: boolean;
	id?: string;
	path?: string;
	compact?: boolean;
}

const { isHome, id, compact } = Astro.props;
const enabled = !isHome && id;
---

{enabled && (
  <div
    class="flex items-center"
  >
    {compact ? (
      <>
        <span class="text-50 text-sm font-medium" data-busuanzi-page-value role="status">{i18n(I18nKey.pageViewsLoading)}</span>
        <span class="text-50 text-sm font-medium ml-1">
          {i18n(I18nKey.pageViews)}
        </span>
      </>
    ) : (
      <>
        <div class="meta-icon">
          <Icon name="material-symbols:visibility-outline-rounded" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium mr-1">
          {i18n(I18nKey.pageViews)}
        </span>
        <span class="text-50 text-sm font-medium" data-busuanzi-page-value role="status">
          {i18n(I18nKey.pageViewsLoading)}
        </span>
      </>
    )}
  </div>
)}
