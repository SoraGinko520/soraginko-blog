---
import Icon from "@components/common/Icon.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getPostUrlBySlug } from "@/utils/url-utils";
import { getVisitSnapshot } from "@/utils/visit-snapshot";

export interface Props {
	isHome?: boolean;
	id?: string;
	path?: string;
	compact?: boolean;
}

const { isHome, id, compact } = Astro.props;
const enabled = !isHome && id;
const pageSnapshot = id
	? getVisitSnapshot()?.pageViews[getPostUrlBySlug(id)]
	: undefined;
const initialValue =
	pageSnapshot?.toLocaleString() ?? i18n(I18nKey.pageViewsLoading);
---

{enabled && (
  <div
    class="flex items-center"
  >
    {compact ? (
      <>
        <span class="text-50 text-sm font-medium" data-busuanzi-page-value data-busuanzi-page-base={pageSnapshot} role="status" title={i18n(I18nKey.visitsLoading)}>{initialValue}</span>
        <span class="text-50 text-sm font-medium ml-1">
          {i18n(I18nKey.pageViews)}
        </span>
      </>
    ) : (
      <>
        <div class="meta-icon">
          <Icon name="material-symbols:visibility-outline-rounded" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium mr-1">
          {i18n(I18nKey.pageViews)}
        </span>
        <span class="text-50 text-sm font-medium" data-busuanzi-page-value data-busuanzi-page-base={pageSnapshot} role="status" title={i18n(I18nKey.visitsLoading)}>
          {initialValue}
        </span>
      </>
    )}
    {pageSnapshot !== undefined && <span class="text-50 text-xs ml-1" data-busuanzi-page-note title={i18n(I18nKey.visitsSnapshotSource)}>{i18n(I18nKey.visitsSnapshotLabel)} {pageSnapshot.toLocaleString()}</span>}
  </div>
)}
