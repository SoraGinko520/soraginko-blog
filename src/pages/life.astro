---
import PageTitle from "@/components/common/PageTitle.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.life) {
	return Astro.redirect("/404/");
}
const title = i18n(I18nKey.life);
const description = i18n(I18nKey.lifeDescription);
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
	<div class="card-base z-10 px-9 py-6 relative w-full">
		<PageTitle title={title} description={description} variant="stacked" />
	</div>
</MainGridLayout>
