---
import Comment from "@components/comment/index.astro";
import Icon from "@components/common/Icon.astro";
import FriendCard from "@components/features/FriendCard.astro";
import FriendChat from "@components/features/FriendChat.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/friends.css";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();

// 按 tags 分组（与原 tabs 一致的排序规则），无标签的归入未分类
const groupMap = new Map<string, typeof items>();
for (const friend of items) {
	const tags = friend.tags?.length ? friend.tags : [null];
	for (const tag of tags) {
		const key = tag ?? "__uncategorized__";
		const list = groupMap.get(key) ?? [];
		list.push(friend);
		groupMap.set(key, list);
	}
}
const groups = [...groupMap.entries()]
	.map(([key, list]) => ({
		label: key === "__uncategorized__" ? i18n(I18nKey.uncategorized) : key,
		items: list,
	}))
	.sort((a, b) => a.label.localeCompare(b.label));

const chatMessages = friendsPageConfig.chat ?? [];

// 页面标题和描述（描述仅用于 SEO meta，不再在页面内显示）
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
  <div class="flex w-full rounded-(--radius-large) relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 lg:px-9 py-6 relative w-full" data-friends-page>
      <!-- 页面标题 -->
      <div class="mb-8">
        <PageTitle
          title={title}
          eyebrow="Friends"
          description={i18n(I18nKey.friendsMotto)}
          variant="stacked"
        />
      </div>

      <!-- 折叠分类列表 -->
      {groups.length > 0 ? (
        <div class="friend-accordion-list">
          {groups.map((group) => (
            <section
              class="friend-accordion"
              data-friend-accordion
              data-open="true"
            >
              <button
                type="button"
                class="friend-accordion-header"
                aria-expanded={true}
              >
                <div class="friend-accordion-title-wrap">
                  <span class="friend-accordion-title">{group.label}</span>
                </div>
                <span class="friend-accordion-count">{group.items.length}</span>
                <Icon
                  name="material-symbols:keyboard-arrow-down-rounded"
                  class="friend-accordion-arrow"
                />
              </button>
              <div class="friend-accordion-body">
                <div class="friend-accordion-body-inner">
                  <div class="friend-card-grid">
                    {group.items.map((friend) => (
                      <FriendCard friend={friend} />
                    ))}
                  </div>
                </div>
              </div>
            </section>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <Icon
            name="material-symbols:link-off-rounded"
            class="text-5xl text-neutral-300 dark:text-neutral-600 mb-4"
          />
          <p class="text-neutral-500 dark:text-neutral-400">
            {i18n(I18nKey.friendEmptyTitle)}
          </p>
          <p class="text-sm text-neutral-400 dark:text-neutral-500 mt-1">
            {i18n(I18nKey.friendEmptyHint)}
          </p>
        </div>
      )}

      <!-- 对话气泡 + 友链规则/本站信息 -->
      <FriendChat messages={chatMessages} />

      <script>
        import { initFriendsPage } from "@/utils/friends-controller";
        import { definePageIsland } from "@/utils/swup-lifecycle";
        let cleanup: (() => void) | undefined;
        definePageIsland({ name: "friends:media", match: () => Boolean(document.querySelector("[data-friends-page]")), mount: () => { cleanup = initFriendsPage(); }, unmount: () => { cleanup?.(); cleanup = undefined; } });
      </script>
    </div>
  </div>

  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment customPath="/friends/" title={title} />
    </div>
  )}
</MainGridLayout>
