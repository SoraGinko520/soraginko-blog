# 在 Waline 的 Vercel 项目 Settings > Environment Variables 中设置。
# Neon 数据库连接由 Vercel Storage 集成注入，密码不可提交到 GitHub。
SITE_NAME=SoraGinko
SITE_URL=https://soraginko.moe
SERVER_URL=https://comment.soraginko.moe
SECURE_DOMAINS=soraginko.moe,www.soraginko.moe,comment.soraginko.moe
COMMENT_AUDIT=true
DISABLE_USERAGENT=true
DISABLE_REGION=true
IPQPS=60
PG_SSL=true
# 不设置 LOGIN=force，允许匿名评论。
# 暂不配置 SMTP、OAuth 提供商、浏览量统计或付费服务。
